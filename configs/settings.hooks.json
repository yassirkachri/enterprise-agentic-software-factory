{
  "hooks": {
    "PreToolUse": [{
      "matcher": "Edit|Write",
      "hooks": [{
        "type": "command",
        "command": "bash",
        "args": [
          "${CLAUDE_PROJECT_DIR}/.claude/hooks/protect-paths.sh"
        ],
        "timeout": 10,
        "onFailure": "block"
      }]
    }],
    "PostToolUse": [{
      "matcher": "Edit|Write",
      "hooks": [{
        "type": "command",
        "command": "bash",
        "args": [
          "${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit.sh"
        ],
        "timeout": 120
      }]
    }],
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": "bash",
        "args": [
          "${CLAUDE_PROJECT_DIR}/.claude/hooks/test-gate.sh"
        ],
        "timeout": 900
      }]
    }]
  }
}
